{
  "question": "a voice agent that phones our customers to confirm appointments, speaking in a synthesized voice",
  "version": "consolidated",
  "claims": [
    {
      "statement": "The system, by phoning customers, is an AI system intended to interact directly with natural persons, triggering the obligation under Article 50(1) to ensure those persons are informed they are interacting with an AI system, unless this is obvious from the point of view of a reasonably well-informed, observant and circumspect person",
      "citations": [
        {
          "provision_id": "art_50.1",
          "citation": "Article 50(1)",
          "kind": "paragraph",
          "version": "consolidated",
          "text": "1. Providers shall ensure that AI systems intended to interact directly with natural persons are designed and developed in such a way that the natural persons concerned are informed that they are interacting with an AI system, unless this is obvious from the point of view of a natural person who is reasonably well-informed, observant and circumspect, taking into account the circumstances and the context of use. This obligation shall not apply to AI systems authorised by law to detect, prevent, investigate or prosecute criminal offences, subject to appropriate safeguards for the rights and freedoms of third parties, unless those systems are available for the public to report a criminal offence.",
          "changed": false,
          "change_note": null
        }
      ]
    },
    {
      "statement": "The information required by Article 50(1) through (4) must be provided to the natural persons concerned in a clear and distinguishable manner at the latest at the time of the first interaction or exposure, and shall conform to applicable accessibility requirements",
      "citations": [
        {
          "provision_id": "art_50.5",
          "citation": "Article 50(5)",
          "kind": "paragraph",
          "version": "consolidated",
          "text": "5. The information referred to in paragraphs 1 to 4 shall be provided to the natural persons concerned in a clear and distinguishable manner at the latest at the time of the first interaction or exposure. The information shall conform to the applicable accessibility requirements.",
          "changed": false,
          "change_note": null
        }
      ]
    },
    {
      "statement": "Where the system was placed on the market before 2 August 2026, Article 111(4) requires the provider to take the necessary steps to comply with Article 50(2) by 2 December 2026",
      "citations": [
        {
          "provision_id": "art_111.4",
          "citation": "Article 111(4)",
          "kind": "paragraph",
          "version": "consolidated",
          "text": "4. Providers of AI systems, including general-purpose AI systems, generating synthetic audio, image, video or text content, that have been placed on the market before 2 August 2026 shall take the necessary steps in order to comply with Article 50(2) by 2 December 2026.",
          "changed": true,
          "change_note": "Article 111(4) appears in the consolidated text and not in the original text."
        }
      ]
    },
    {
      "statement": "The obligations in Article 50(1) to (4) do not affect the requirements and obligations set out in Chapter III and are without prejudice to other transparency obligations laid down in Union or national law, per Article 50(6)",
      "citations": [
        {
          "provision_id": "art_50.6",
          "citation": "Article 50(6)",
          "kind": "paragraph",
          "version": "consolidated",
          "text": "6. Paragraphs 1 to 4 shall not affect the requirements and obligations set out in Chapter III, and shall be without prejudice to other transparency obligations laid down in Union or national law for deployers of AI systems.",
          "changed": false,
          "change_note": null
        }
      ]
    }
  ],
