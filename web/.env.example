# Where the answer endpoint is listening. Start it with:
#   cd python && uv run python -m annex serve
#
# 4200 sits above the 4100 to 4150 band `scripts/worktree-port.sh` derives for
# the web app, so a linked worktree's dev server cannot land on it.
NEXT_PUBLIC_ANNEX_API_URL=http://localhost:4200

# Unset, or anything other than `replay`, and the build calls the service above.
# Set to `replay` and the build answers from `src/fixtures/` instead, exports as
# static files, and says on every screen that it is a recording.
#
# A local build leaves this unset. The deploy workflow sets it, and it is the
# only build that does, because the model this project runs holds 30 GB of a
# card and nothing hosted answers these questions.
# NEXT_PUBLIC_ANNEX_MODE=replay
